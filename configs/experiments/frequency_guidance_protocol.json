  "fixed": {
    "backbone": "ViT-B/16",
    "precision": "fp32",
    "image_batch_size": 32,
    "lambda_I": 0.1,
    "lambda_T": 0.5,
    "tau_visual": 16,
    "tau_text": 16,
    "eta": 0.5,
    "band_weights": [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
    ],
    "using_ensemble": true,
    "gamma_base": 1.0,
    "gamma_inc": 5.0,
    "frequency_backend": "safd",
    "view_mode": "natural",
    "low_terms": 8,
    "middle_terms": 24,
    "original_blend": [
      0.25,
      0.1
    ],
    "high_enhance": 0.25,
    "max_detail_rms": 0.04,
    "safd_radii": [
      0,
      0.3,
      0.6,
      0.8
    ],
    "safd_angles": 16,
    "safd_max_signals": 96,
    "safd_batch_size": 2,
    "candidates_per_class_per_scale": 5,
    "frequency_base_support_budget": "all_available_base_training_support",
    "extra_gda": false,
    "dual_prediction_repair": false,
    "consensus": false,
    "router": false,
    "residual_head": false,
    "query_auxiliary_frequency_encodings": 0
  },
  "methods": [
    {
      "id": "G0",
      "name": "BiMC without visual guidance",
      "implementation": "available_as_G0",
      "lambda_I": 0,
      "rho_grid": null,
      "formula": "v_guided = v0"
    },
    {
      "id": "G1",
      "name": "Original full BiMC",
      "implementation": "available_as_G1",
      "lambda_I": 0.1,
      "rho_grid": null,
      "formula": "a0 = softmax(16*cos(v0_c,v0_b))"
    },
    {
      "id": "G2",
      "name": "Visual scale relation guidance",
      "implementation": "available_as_G2",
      "lambda_I": 0.1,
      "rho_grid": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ],
      "formula": "a = (1-rho)*a0 + rho*mean_s(p_s)"
    },
    {
      "id": "G3",
      "name": "Unpaired marginal cross-modal relation guidance",
      "implementation": "available_as_G3",
      "lambda_I": 0.1,
      "rho_grid": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ],
      "formula": "a = (1-rho)*a0 + rho*normalize(mean_s(p_s)^(1-eta)*mean_s(q_s)^eta)"
    },
    {
      "id": "G4",
      "name": "Paired scale cross-modal relation guidance",
      "implementation": "available_as_G4",
      "lambda_I": 0.1,
      "rho_grid": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ],
      "formula": "r_s = normalize(p_s^(1-eta)*q_s^eta); a = (1-rho)*a0 + rho*mean_s(r_s)"
    }
  ],
  "selection": {
    "source": "base_training_only",
    "class_split": "disjoint_half_base_bank_half_pseudo_novel",
    "seed_offset": 10101,
    "sequences": 20,
    "old_support": "all_training_except_old_queries",
    "old_query_per_class": 5,
    "new_support_per_class": 5,
    "new_query_per_class": 5,
    "audit_images_per_validation_class": 5,
    "audit_reservation": "fixed_per_class_across_all_sequences_excluded_from_selection",
    "minimum_training_images_per_validation_class": 15,
    "objective": "mean_incremental_stage_harmonic_accuracy_of_pseudo_base_and_all_arrived_pseudo_novel",
    "maximum_mean_old_drop_pp_vs_G1": 0.2,
    "maximum_mean_new_drop_pp_vs_G1": 0.2,
    "tie_break": "smallest_rho",
    "rho_zero_reference": "G1",
    "refit": "all_real_base_training_support_after_freezing_rho",
    "forbidden": [
